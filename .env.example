# Copy to .env.local and fill in to use the remote (Supabase/Vercel) backend.
# Leave VITE_API_BASE unset to run fully local (localStorage + BroadcastChannel).

# Client → point the kiosk/console at your deployed API (blank = local mode).
VITE_API_BASE=

# Admin console demo passcode (placeholder for Supabase Auth).
VITE_ADMIN_PASSCODE=connect2026

# Server-side (Vercel project env) — used by api/ serverless functions:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
